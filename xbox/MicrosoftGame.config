<?xml version="1.0" encoding="utf-8"?>
<!--
  MicrosoftGame.config : Xbox GDK package manifest for Newtonia

  The __FILL_*__ tokens below are intentionally left in source: the deploy
  workflow (.github/workflows/disabled/deploy-xbox.yml, "Stage layout")
  substitutes them from GitHub secrets at build time, so no deployment-specific
  identity is committed and the repo stays reusable. Do NOT hardcode real
  values here. (Same pattern as Steam's app_build.vdf appid placeholder.)

  Token -> secret -> Partner Center source (see xbox/PARTNER_CENTER_VALUES.md):
    __FILL_IDENTITY_NAME__          : XBOX_IDENTITY_NAME          : Product identity, Package/Identity Name
    __FILL_IDENTITY_PUBLISHER__     : XBOX_IDENTITY_PUBLISHER     : Product identity, Package/Identity Publisher (full "CN=...")
    __FILL_PUBLISHER_DISPLAY_NAME__ : XBOX_PUBLISHER_DISPLAY_NAME : Account, Publisher display name (used twice below)
    __FILL_STORE_ID__               : XBOX_STORE_ID               : Product identity, Store ID (12 chars)

  Image assets (paths relative to the layout root, xbox_output/ in the
  workflow). Required sizes (GDK shell):
    StoreLogo.png      : 100 x 100
    Logo480x480.png    : 480 x 480   (Square480x480Logo, tile)
    Logo150x150.png    : 150 x 150   (Square150x150Logo, small tile)
    SplashScreen.png   : 1920 x 1080
  Placeholder versions live in xbox/Assets/ (regenerate with
  xbox/generate_assets.py); replace with real art before store submission.
  The deploy workflow copies xbox/Assets/ into the layout.
-->
<Game configVersion="1">

  <Identity Name="__FILL_IDENTITY_NAME__"
            Publisher="__FILL_IDENTITY_PUBLISHER__"
            Version="1.0.0.0"/>

  <ExecutableList>
    <!-- "Scarlett" = Xbox Series X|S only, matching the Gaming.Xbox.Scarlett.x64
         build target (Scarlett binaries cannot run on Xbox One hardware).
         An Xbox One package would need a separate Gaming.Xbox.XboxOne.x64
         build — see xbox/PORT_PLAN.md §2 (non-goal for v1). -->
    <Executable Name="newtonia.exe"
                TargetDeviceFamily="Scarlett"
                Id="Game"/>
  </ExecutableList>

  <DefaultDisplayName>Newtonia</DefaultDisplayName>

  <PublisherDisplayName>__FILL_PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>

  <Description>Top-down 2D space shooter. Destroy asteroids, fight enemies, survive.</Description>

  <StoreId>__FILL_STORE_ID__</StoreId>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <ShellVisuals DefaultDisplayName="Newtonia"
                PublisherDisplayName="__FILL_PUBLISHER_DISPLAY_NAME__"
                StoreLogo="Assets\StoreLogo.png"
                Square480x480Logo="Assets\Logo480x480.png"
                Square150x150Logo="Assets\Logo150x150.png"
                SplashScreenImage="Assets\SplashScreen.png"
                ForegroundText="light"
                BackgroundColor="#000000"/>

</Game>
