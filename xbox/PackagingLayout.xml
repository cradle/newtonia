<?xml version="1.0" encoding="utf-8"?>
<!--
  PackagingLayout.xml — consumed by the GDK makepkg tool.

  Usage (from the workflow):
    makepkg pack /f xbox\PackagingLayout.xml /d xbox_output /pd packages

  xbox_output/ layout expected by this file
  -----------------------------------------
    xbox_output\
      MicrosoftGame.config
      Assets\                   (tile / splash images)
      bin\
        newtonia.exe
        opengl32.dll            (Mesa GLon12 — decided console renderer)
        libgallium_wgl.dll      (Mesa GLon12 Gallium WGL frontend)
        dxil.dll                (DXIL shader signing for GLon12, if required)
        audio\                  (WAV + MP3 files)

  (Abandoned ANGLE fallback shipped libEGL.dll / libGLESv2.dll here instead;
   the GLon12 path above is the decided renderer — see xbox/PORT_PLAN.md.)

  The single "Launch" chunk contains everything; there is no streaming /
  optional DLC content, so a flat single-chunk layout is sufficient.
-->
<PackagingLayout xmlns="http://schemas.microsoft.com/gdk/2020/packagelayout">

  <!-- Scarlett (Series X|S) only — must match the Executable's
       TargetDeviceFamily in MicrosoftGame.config and the
       Gaming.Xbox.Scarlett.x64 build target. -->
  <PackageFamily ID="Newtonia_retail" TargetDeviceFamily="Scarlett">

    <Package ID="Newtonia" Version="[version]">

      <ChunkMap>
        <Chunk ID="1000" Marker="Launch">

          <!-- Game config (must sit at the layout root) -->
          <FileGroup DestinationPath="\"
                     SourcePath="\"
                     IncludePattern="MicrosoftGame.config"/>

          <!-- Store / shell image assets -->
          <FileGroup DestinationPath="\Assets\"
                     SourcePath="\Assets\"
                     IncludePattern="*"/>

          <!-- Executable + renderer DLLs (Mesa GLon12: opengl32.dll,
               libgallium_wgl.dll, dxil.dll — the decided console renderer) -->
          <FileGroup DestinationPath="\"
                     SourcePath="\bin\"
                     IncludePattern="*.exe;*.dll"/>

          <!-- Audio assets -->
          <FileGroup DestinationPath="\audio\"
                     SourcePath="\bin\audio\"
                     IncludePattern="*"/>

        </Chunk>
      </ChunkMap>

    </Package>
  </PackageFamily>

</PackagingLayout>
