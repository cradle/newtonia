# Cold open: the lance mirror-bouncing off a reflective asteroid. No title,
# no caption — open on the single most distinctive thing the game does and
# let it play. ~5s.
seed 31
sim 500
frames 156
fps 30
size 1920 1080
clear
hud off
camera fixed
zoom 55
ship 0 -230 0
pickup lance 0 -230
asteroid -300 170 reflective r=110
asteroid 330 210 reflective r=110
asteroid 20 400 reflective r=120
asteroid -120 40 r=60
asteroid 165 15 r=55
asteroid 420 -60 r=55
asteroid -420 -30 r=50
key space 700
key space 1500
key space 2300
key space 3100
key space 3900
