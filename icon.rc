MAINICON ICON "spaceship.ico"

// Application manifest (RT_MANIFEST, id 1) + VERSIONINFO: an unsigned
// MinGW-static exe with neither is the exact profile Defender's ML
// heuristics flag (Trojan:Win32/Bearfoos.A!ml appeared on the netplay
// build the moment it grew sockets and TLS). Numeric type/OS constants
// instead of winver.h names keep windres happy without includes. The
// version here is informational — bump alongside release tags.
1 24 "newtonia.exe.manifest"

1 VERSIONINFO
FILEVERSION     1,41,0,0
PRODUCTVERSION  1,41,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Metonymous"
            VALUE "FileDescription",  "Newtonia - top-down space shooter"
            VALUE "FileVersion",      "1.41.0.0"
            VALUE "InternalName",     "newtonia"
            VALUE "LegalCopyright",   "(c) 2026 Metonymous"
            VALUE "OriginalFilename", "newtonia.exe"
            VALUE "ProductName",      "Newtonia"
            VALUE "ProductVersion",   "1.41.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
