<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Entitlements for local development builds from Xcode (set as
         CODE_SIGN_ENTITLEMENTS in the project), so sandbox Game Center
         works on-device without a TestFlight round trip. Release builds
         use Entitlements.plist, injected by deploy-ios.yml on the
         xcodebuild command line, which overrides this setting. Automatic
         signing fills in application-identifier / get-task-allow. -->
    <key>com.apple.developer.game-center</key>
    <true/>

    <!-- Universal Links (ios_universal_link.mm) for local device testing.
         Needs the App ID's Associated Domains capability + the site's
         apple-app-site-association; see Entitlements.plist. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:newtonia.metonymous.com</string>
    </array>

    <!-- LAN discovery broadcast (net_lan.cpp); needs the App ID's
         Multicast Networking capability + a regenerated profile, see
         Entitlements.plist. -->
    <key>com.apple.developer.networking.multicast</key>
    <true/>
</dict>
</plist>
