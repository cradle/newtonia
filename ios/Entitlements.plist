<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>application-identifier</key>
    <string>TEAM_ID_PLACEHOLDER.cc.gfm.Newtonia</string>

    <key>get-task-allow</key>
    <false/>

    <!-- Game Center achievements (game_center_achievements.mm). The App ID
         in the Developer Portal must have the Game Center capability enabled
         and the provisioning profile regenerated afterwards, or signing
         rejects this entitlement. -->
    <key>com.apple.developer.game-center</key>
    <true/>

    <!-- Universal Links for co-op join links (ios_universal_link.mm). The App
         ID must have the "Associated Domains" capability enabled (regenerate
         the provisioning profile after), and the site must serve
         /.well-known/apple-app-site-association naming
         <TeamID>.cc.gfm.Newtonia for the /join path. Without all three a
         tapped link opens the browser fallback instead of the app. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:newtonia.metonymous.com</string>
    </array>
</dict>
</plist>
