<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SDL2 needs this to handle controller / audio -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Online co-op (NETPLAY.md): relay WebSocket + WebRTC data channels -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- LAN co-op discovery (net_lan.cpp): the MulticastLock that stops
         the wifi driver filtering the UDP discovery beacons. Install-time
         grant, no runtime prompt. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Declare that we use OpenGL ES 2.0 -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Low-latency audio is preferred for responsive sound effects -->
    <uses-feature android:name="android.hardware.audio.low_latency"
                  android:required="false" />

    <!-- Touchscreen is not required (controllers / large-screen devices) -->
    <uses-feature android:name="android.hardware.touchscreen"
                  android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="false"><!--
        Opt OUT of the predictive-back system. At targetSdk 35+ this flag
        defaults to TRUE, which routes Back through OnBackInvokedCallback and
        stops delivering the legacy KEYCODE_BACK keypress — SDL's back handling
        (android_main.cpp: SDLK_AC_BACK -> back_pressed()) relies on that key,
        so without this the in-game Back skipped straight to Home instead of
        returning to the menu. false restores the legacy dispatch. -->

        <!-- Play Games Services project ID (achievements backend). Must be a
             @string reference — an inline numeric value gets parsed as an int
             and the SDK rejects it. Placeholder lives in values/games-ids.xml
             until the Play Console project exists. -->
        <meta-data android:name="com.google.android.gms.games.APP_ID"
                   android:value="@string/game_services_project_id" />

        <activity
            android:name="org.newtonia.NewtoniaActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|fontScale|screenLayout|density|uiMode"
            android:launchMode="singleTask"
            android:exported="true"><!--
            No android:screenOrientation lock: Google Play flags orientation
            restrictions on large-screen devices, and at targetSdk 36 (Android
            16) the system already ignores the lock on screens >= 600dp
            (tablets, foldables, desktop windowing). The game adapts to any
            window size at runtime — android_main.cpp forwards every size change
            to GLGame::resize / Typer::resize / touch_controls_resize, the touch
            layout is computed proportionally, and the projection is
            aspect-symmetric (half_w = half_h * aspect) — so portrait renders a
            taller/narrower slice rather than breaking. configChanges above
            (orientation|screenSize) keeps rotation from recreating the
            activity, so it's a seamless SDL resize. -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Co-op join links (App Links). A tapped
                 https://newtonia.metonymous.com/join?code=XXXX opens the game;
                 NewtoniaActivity hands the code to Invites::note_accepted via
                 nativeAcceptInvite (android_main.cpp). autoVerify makes Android
                 fetch /.well-known/assetlinks.json at install so the link opens
                 the app directly (no chooser) — the file must name this package
                 and the release signing cert's SHA-256. singleTask above makes
                 a link tapped while the game is running arrive at onNewIntent
                 rather than spawning a second task. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="newtonia.metonymous.com"
                      android:pathPrefix="/join" />
            </intent-filter>
        </activity>
    </application>

</manifest>
