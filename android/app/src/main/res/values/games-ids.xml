<!-- Google Play Games Services IDs (ACHIEVEMENTS.md §2, Play Games backend).

     game_services_project_id: the numeric project ID of the "newtonia"
     Play Games Services game project in the Play Console (referenced from
     AndroidManifest.xml as the com.google.android.gms.games.APP_ID
     meta-data).

     Achievement IDs are the console-generated values (entered 2026-07-13),
     stored under the resource names fixed by the mapping table in
     play_games_achievements.cpp (authoritative). The console's own "Get
     resources" export derives different names from the display names
     (e.g. achievement_first_blood) — when re-exporting after a console
     change, remap the ID values onto these names; do not adopt the
     export's names. -->
<resources>
    <string name="game_services_project_id" translatable="false">717199808901</string>

    <!-- Netplay identity attestation (NETPLAY.md V2, PlayGamesIdentity.java).
         The OAuth 2.0 WEB client id (Google Cloud console → Credentials, the
         "web" client under this game's project — NOT the Android client id).
         GamesSignInClient.requestServerSideAccess mints an auth code redeemable
         only with the matching client SECRET, which the signal worker holds
         (Cloudflare secret PLAY_GAMES_OAUTH_CLIENT_SECRET; play_games_verify.js).
         Left commented out until the web OAuth client exists: with the resource
         absent, no server auth code is minted and an Android peer stays
         role-labelled online — the same graceful degradation as the worker
         running without its secret. Uncomment and paste the id to enable
         attestation. -->
    <!-- <string name="play_games_oauth_client_id" translatable="false">PASTE_WEB_OAUTH_CLIENT_ID_HERE.apps.googleusercontent.com</string> -->
